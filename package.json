{
  "name": "portal-console",
  "version": "0.1.0",
  "description": "A Portal-inspired multi-screen terminal for Linux, macOS, and Windows",
  "author": "Portal Console contributors",
  "main": "src/main.js",
  "type": "commonjs",
  "bin": {
    "portal-console": "scripts/launch.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/launch.js",
    "headless": "node scripts/launch.js --headless",
    "test": "node --test",
    "dist": "npm run build && electron-builder",
    "installer:win": "npm run build && electron-builder --dir --config.directories.output=release-current && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-installer.ps1 -ReleaseDirectory release-current"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "sharp": "0.35.3",
    "vpk-tools": "^1.0.3"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.9"
  },
  "build": {
    "appId": "science.aperture.portalconsole",
    "productName": "Portal Console",
    "executableName": "portal-console",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "afterPack": "scripts/after-pack.js",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "mac": {
      "extraResources": [
        {
          "from": "node_modules/node-pty/prebuilds/darwin-x64",
          "to": "app.asar.unpacked/node_modules/node-pty/prebuilds/darwin-x64",
          "filter": ["pty.node", "spawn-helper"]
        },
        {
          "from": "node_modules/node-pty/prebuilds/darwin-arm64",
          "to": "app.asar.unpacked/node_modules/node-pty/prebuilds/darwin-arm64",
          "filter": ["pty.node", "spawn-helper"]
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
